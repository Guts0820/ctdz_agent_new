# Copy this file to backend/.env for local development. Keep real keys out of Git.
# Shared text generation uses Qwen only. Set LLM_MODEL to any available Qwen model.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
QWEN_EMBEDDING_API_KEY=
QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_MODEL=text-embedding-v3
QWEN_EMBEDDING_DIMENSIONS=1024
QWEN_EMBEDDING_TIMEOUT_SECONDS=30
KG_VECTOR_INDEX_NAME=question_embedding_index
KG_VECTOR_TOP_K=10
OCR_MIN_CONFIDENCE=0.80
STANDARD_ANSWER_OCR_MIN_CONFIDENCE=0.95
TEACHER_SERVICE_URL=http://127.0.0.1:8090

# 内部服务监听地址：默认只服务本机（127.0.0.1）。
# 仅在确实需要从其他机器直连内部服务时才改成 0.0.0.0（会暴露未脱敏数据）。
SERVICE_BIND_HOST=127.0.0.1

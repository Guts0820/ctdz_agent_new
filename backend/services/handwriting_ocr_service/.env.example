# Do not commit a real .env file. OCR uses Qwen by default and validates its JSON output.
OCR_RUNTIME_ENV=development
OCR_ENGINE=qwen
# Leave empty to use the environment default; set cpu or gpu only when needed.
PADDLEOCR_VL_DEVICE=
PADDLEOCR_VL_PIPELINE_VERSION=v1.6
OCR_CONFIDENCE_THRESHOLD=0.80
MAX_IMAGE_BYTES=10485760

# Qwen multimodal OCR and question explanation.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-3.7plus
QWEN_TIMEOUT_SECONDS=60

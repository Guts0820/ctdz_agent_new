# 复制为本目录 .env；不要提交真实密钥。
# 该配置只供 analysis_service 使用，不读取 backend/.env 的 LLM 配置。
ANALYSIS_LLM_API_KEY=
ANALYSIS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ANALYSIS_LLM_MODEL=qwen3.7-plus
ANALYSIS_LLM_TIMEOUT_SECONDS=60
# Candidate acceptance gates. Ambiguous matches never enter judging.
ANALYSIS_QUESTION_MATCH_MIN_CONFIDENCE=0.90
ANALYSIS_QUESTION_MATCH_MIN_MARGIN=0.10
